{
  "schema": "competition.lineage_update_policy.v1",
  "version": "2026.09.09.1",
  "defaultProfile": "agent2_execution_input_lineage",
  "profiles": {
    "agent2_execution_input_lineage": {
      "description": "Bind the real compiled Agent2 input under its active claim before execution. Verify that exact input on acceptance, preserve preparation/provider failures, and diagnose historical input descendants using Artifact edges. No output acceptance bypass, automatic dead-letter replay, second runtime or Java authority transfer.",
      "requireBaselineVerified": true,
      "requireTargetVerified": true,
      "requireRuntimeHashStable": false,
      "requireGraphHashStable": false,
      "allowRuntimeMembershipChange": true,
      "allowEdgeChanges": true,
      "allowRegistryModuleChanges": true,
      "allowedRuntimePathPrefixes": [
        "config/v23_registry_runtime.json",
        "src/services/agent2_runtime_v22515_service.py",
        "src/services/agent_token_runtime_v22520_service.py",
        "src/services/agent2_runtime_resilience_v2143_service.py",
        "config/deployment/agent2_lineage_status.py"
      ],
      "allowedRegistryModules": [
        "agent2_runtime"
      ],
      "allowedNodePrefixes": [],
      "allowedSpecialHashChanges": [
        "registryRootHash"
      ]
    }
  }
}
