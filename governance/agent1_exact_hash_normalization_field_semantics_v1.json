  "semanticModes": {
    "agent1_exact_hash_native_normalization": {
      "identityFields": ["itemExecutionId", "inputContentHash"],
      "businessReferenceFields": ["storeId", "productId", "signalId"],
      "businessOutputFields": ["decisionType", "agent1OperatingJudgment", "executionLock", "lockedActionFamily"],
      "writebackField": "pipelineItemId",
      "rule": "Once itemExecutionId+inputContentHash matches, that exact input Artifact owns the judgment identity. Legacy business identity matching and legacy hard-coded action-family whitelists may not delete or rebind the judgment. Decision alias canonicalization and execution-lock shaping remain allowed as non-identity formatting/guardrail steps; downstream Action Matrix/capability boundaries decide executability."
    }
