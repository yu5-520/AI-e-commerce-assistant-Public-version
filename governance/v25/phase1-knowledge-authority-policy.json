{
  "schema": "v25.phase1.knowledge_authority_policy.v1",
  "version": "25.2.0-phase1",
  "enforcementMode": "SHADOW",
  "goal": "建立统一RAG知识盘点、统一RAG字段注册表和知识分布域，不改变现有生产Agent输入与RAG写入权。",
