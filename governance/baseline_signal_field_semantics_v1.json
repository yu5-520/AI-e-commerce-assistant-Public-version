  "semanticModes": {
    "first_report_baseline": {
      "businessOutputTypes": ["baseline_product_bundle","validated_baseline_product_bundle","baseline_history_gate_closed"],
      "signalEligibility": false,
      "baselineGate": "closed_before_signal_engine",
      "zeroAllowedFields": ["productSignalPackageCount","validatedSignalCount","generatedSignalCount","admittedSignalCount","agent1PendingItemCount"],
      "positiveEvidenceFields": ["baselineProductBundleCount"],
      "contractValidationOk": true,
      "validationStatus": ["passed"]
    },
    "comparable_delta": {
      "businessOutputTypes": ["full_product_signal_snapshot","validated_product_signal_snapshot","artifact_signal_admission"],
      "signalEligibility": true,
      "baselineGate": "open_after_previous_snapshot",
      "zeroAllowedFields": ["productSignalPackageCount","bundleCount","validatedSignalCount","generatedSignalCount","admittedSignalCount","agent1PendingItemCount"],
      "rule": "Signal eligibility opens permission to emit Signals; it never creates a minimum Signal count."
    }
  },
