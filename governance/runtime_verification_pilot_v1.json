{
  "schema": "competition.runtime_verification_pilot.v1",
  "version": "2026.08.10.1",
  "pilotOnly": true,
  "extractionToMotherArchitectureAllowed": false,
  "modes": ["repository", "ecs-candidate", "ecs-runtime"],
  "requiredSourceFiles": [
    "requirements.lock",
    "contracts/registry/fields.json",
    "contracts/registry/interfaces.json",
    "config/v23_registry_runtime.json",
    "governance/runtime_callable_authority_v1.json",
    "scripts/competition_execution_gate.py"
  ],
  "sourceIdentityFiles": [
    "requirements.lock",
    "contracts/registry/fields.json",
    "contracts/registry/interfaces.json",
    "contracts/registry/migrations.json",
    "config/competition_runtime_scope.json",
    "config/v23_registry_runtime.json",
    "governance/runtime_callable_authority_v1.json",
    "governance/runtime_verification_pilot_v1.json"
  ],
  "runtimeEnvironmentKeys": [
    "AI_ECOMMERCE_ROOT",
    "AI_RELEASE_REQUIRED",
    "AI_RELEASE_PYTHON",
    "AI_BOOTSTRAP_PYTHON",
    "PYTHONPATH",
    "VIRTUAL_ENV",
    "PORT"
  ],
  "secretPresenceKeys": [
    "DASHSCOPE_API_KEY",
    "QWEN_API_KEY",
    "OPENAI_API_KEY",
    "DEEPSEEK_API_KEY"
  ],
  "database": {
    "defaultRelativePath": "shared/logs/product_workbench.sqlite3",
    "stateTables": [
      "imported_report_rows",
      "pipeline_jobs",
      "station_queue",
      "pipeline_items",
      "artifact_registry",
      "frontend_view_head_v2259"
    ],
    "quickCheckRequired": true,
    "hashSchemaSeparatelyFromState": true
  },
  "runtime": {
    "processNeedles": ["uvicorn", "src.api.main:app"],
    "requiredPythonMajorMinor": "3.11",
    "currentSymlinkMustMatchLiveCwd": true
  },
  "identity": {
    "source": ["expectedSourceCommit", "sourceIdentityHash", "repositoryGateHash"],
    "runtime": ["pythonIdentityHash", "dependencyHash", "runtimeEnvHash", "runtimeCallableAuthorityHash"],
    "database": ["databaseSchemaHash", "databaseStateHash"],
    "execution": "sha256(source + runtime + database)"
  },
  "rules": [
    "The same gate implementation must run in repository, ECS candidate and ECS live-runtime contexts.",
    "RepositoryGateHash must remain identical when the same source candidate is revalidated on ECS.",
    "Secret values are never emitted or hashed; only configured secret presence booleans may be recorded.",
    "Database schema identity and mutable database state identity are separate hashes.",
    "ECS runtime mode must bind identity to the actual uvicorn process cwd, process environment and current symlink.",
    "This is a competition-repository pilot. Do not extract it into the mother architecture until real deployments establish low false-positive and low missed-breakpoint rates."
  ]
}
