{
  "schema": "competition.agent3_semantic_sop_microbatch.v1",
  "version": "23.2.17",
  "objective": "Reuse only clean current-contract Agent3 SOP business bodies under a separate SemanticHash and reduce initial Provider calls with compatible, character-budgeted microbatches while preserving exact ExecutionHash, current system revalidation, singleton auxiliary repair and the single Worker.",
  "baseRuntime": {
    "activeTokenFacade": "src.services.agent_token_runtime_v225_service",
    "agent3Runtime": "src.services.agent3_runtime_v23215_service:run_agent3_sop_projected_inputs",
    "systemCompiler": "src.services.agent3_sop_core_v225_service:_normalize_sop",
    "systemConstraint": "src.services.agent3_system_constraint_v23215_service:validate_agent3_sop_system_contract",
    "executionLedger": "artifact_execution_index_v2259",
    "executionAuthority": "ExecutionHash+current input Artifact",
    "singleWorkerRequired": true
  },
  "semanticCache": {
    "semanticIdentitySchema": "agent3.semantic_sop_identity.v1",
    "cacheContractVersion": "23.2.17",
    "lookupStatus": "accepted",
    "sourceMustBeProviderGenerated": true,
    "sourceSemanticResultCacheHit": false,
    "sourceAllowedStatuses": ["sop_ready", "sop_requires_approval"],
    "sourceContractValidationPassed": true,
    "sourceSemanticContractMissing": [],
    "sourceAuxiliaryRepairAttempted": false,
    "sourceAuxiliaryRepairApplied": false,
    "requestCacheEnabled": false,
    "itemResultCacheEnabled": true,
    "exactExecutionReplayPriority": 1,
    "semanticSopReplayPriority": 2,
    "providerCallPriority": 3,
    "semanticHitProviderCalls": 0,
    "semanticHitMustClaimCurrentExecution": true,
    "semanticHitMustReNormalizeCurrentPackage": true,
    "semanticHitMustRevalidateCurrentSystemContract": true,
    "semanticHitMustCreateNewOutputArtifact": true,
    "semanticHitOutputParents": [
      "current Agent3 input Artifact",
      "semantic source Agent3 output Artifact"
    ],
    "oldOutputMayBecomeCurrentOutputRefDirectly": false,
    "crossProductReuseAllowed": false
  },
  "semanticIdentity": {
    "excludedExecutionFields": [
      "packageId",
      "itemId",
      "dataVersion",
      "correlationId",
      "signalId",
      "executionId",
      "itemExecutionId",
      "executionHash",
      "runtimeExecutionHash",
      "inputArtifactRef",
      "inputContentHash",
      "outputArtifactRef",
      "outputContentHash",
      "rawBatchOutputRef",
      "agent2DraftExecutionProof",
      "agent3ExecutionProof",
      "providerRequestId",
      "semanticCallId"
    ],
    "requiredBusinessSemantics": [
      "productId",
      "storeId",
      "lockedActionFamily",
      "decisionContext",
      "actionSources.agent2ActionDraft",
      "actionSources.actionParameterPack",
      "actionSources.recentFiveOrLatestFacts",
      "constraints",
      "companyContext",
      "allowedActionTypes",
      "requiredActionTypeGroups",
      "outputStepContract",
      "allowedStopConditionTypes",
      "allowedRollbackConditionTypes",
      "auxiliaryConditionContract",
      "systemConstraintContract"
    ],
    "requiredGenerationContract": [
      "inputSchema",
      "projectionVersion",
      "promptVersion",
      "agent3CoreVersion",
      "agent3SystemConstraintVersion",
      "policyHash",
      "provider",
      "model",
      "generationParametersHash"
    ]
  },
  "microbatch": {
    "enabled": true,
    "defaultCapacity": 2,
    "hardMaximumCapacity": 6,
    "batchBudgetAuthority": "AGENT3_MAX_BATCH_CHARS",
    "compatibilityGroupingRequired": true,
    "compatibilityFields": [
      "lockedActionFamily",
      "companyContext",
      "allowedActionTypes",
      "requiredActionTypeGroups",
      "forbiddenActions",
      "outputStepContract",
      "allowedStopConditionTypes",
      "allowedRollbackConditionTypes",
      "auxiliaryConditionContract",
      "systemConstraintContract",
      "promptVersion",
      "provider",
      "model",
      "generationParametersHash"
    ],
    "initialProviderCallCanContainMultipleItems": true,
    "auxiliaryRepairBatchingAllowed": false,
    "auxiliaryRepairMaxAttemptsPerItem": 1,
    "parallelProviderCallsAllowed": false,
    "secondWorkerAllowed": false,
    "legacySingletonSentinelPromotedByActiveFacade": true
  },
  "proof": {
    "providerProof": "providerCallExecuted=true + providerRequestId",
    "exactReplayProof": "exactReplayValidated=true",
    "semanticReplayProof": "semanticReplayValidated=true",
    "semanticReplayProviderCallExecuted": false,
    "semanticReplayProviderRequestId": null,
    "semanticCallIdRequired": true,
    "fallbackAllowed": false
  },
  "allowedRuntimeChanges": [
    "src/services/agent3_runtime_v23215_service.py",
    "src/services/agent_token_runtime_v225_service.py",
    "src/services/agent_runtime_contract_v225_service.py"
  ],
  "verificationOnlyChanges": [
    "tests/test_agent3_semantic_sop_microbatch_v1.py",
    "scripts/verify_agent3_semantic_sop_microbatch.py",
    "governance/agent3_semantic_sop_microbatch_v1.json",
    "governance/competition_lineage_update_policy.json",
    ".github/workflows/competition-agent3-semantic-microbatch.yml"
  ],
  "invariants": {
    "registryRootRotated": false,
    "runtimeMembershipChanged": false,
    "registryRunnerChanged": false,
    "signalAdmissionChanged": false,
    "agent1RuntimeChanged": false,
    "agent2RuntimeChanged": false,
    "hashRoutedRagRouteChanged": false,
    "providerConfiguredByThisPatch": false,
    "modelConfiguredByThisPatch": false,
    "promptBusinessContractChanged": false,
    "temperatureChanged": false,
    "thinkingChanged": false,
    "tokenBudgetChanged": false,
    "requestCacheEnabled": false,
    "secondWorkerAllowed": false,
    "parallelProviderCallsAllowed": false,
    "exactExecutionHashDefinitionChanged": false,
    "taskMappingBusinessLogicChanged": false,
    "taskPoolChanged": false,
    "auxiliaryRepairScopeExpanded": false,
    "auxiliaryRepairAttemptCountIncreased": false
  },
  "acceptanceCriteria": [
    "Package/dataVersion/execution identity changes may preserve SemanticHash when compiled Agent3 business semantics are identical.",
    "Product/store/action family/Agent2 draft/company SOP RAG/company policy/brand/approval or generation contract changes must invalidate SemanticHash.",
    "Exact accepted ExecutionHash replay is checked before semantic lookup.",
    "Only clean Provider-generated SOP outputs that already passed the current Agent3 system contract may seed semantic reuse.",
    "A semantic hit performs zero Provider calls, sets semanticReplayValidated=true, keeps providerCallExecuted=false, re-runs _normalize_sop, revalidates the current system contract and creates a new current output Artifact.",
    "Two compatible Agent3 items within character budget may share one initial Provider call.",
    "Incompatible company/action-family contexts must be placed in separate initial Provider calls.",
    "Auxiliary repair remains singleton and at most once per item.",
    "No async fan-out, ThreadPool, second Worker, new cache table or Registry member is introduced."
  ],
  "registryPolicy": {
    "registryRootRotationRequired": false,
    "runtimeProjectionUpdateRequired": false,
    "runtimeMembershipChangeRequired": false,
    "activeBindingOwnerUpdateRequired": false,
    "lineageUpdateProfile": "governance_bootstrap"
  }
}
