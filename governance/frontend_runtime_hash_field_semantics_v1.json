  "semanticModes": {
    "current_runtime_view": {
      "identityFields": ["dataVersion", "runtimeStateHash", "canonicalProductSetSnapshotHash"],
      "publicationField": "manifestHash",
      "rule": "dataVersion identifies the active dataset; runtimeStateHash includes mutable execution state and canonicalProductSetSnapshotHash; any canonical product-set change republishes the Head."
    },
    "canonical_product_module": {
      "identityFields": ["canonicalProductSetSnapshotHash", "sourceSnapshotHash", "businessContentHash", "contentHash"],
      "publicationField": "artifactRef",
      "rule": "Products module is materialized only from canonical product projection. Signal admission cannot reduce its inventory; sourceSnapshotHash must equal the canonical set hash."
    },
    "immutable_artifact_cache": {
      "identityFields": ["artifactRef", "contentHash"],
      "rule": "Immutable manifests/modules remain cacheable by contentHash; the mutable Head must be fetched uncached."
    }
  },
  "requiredRuntimeAnchors": [
    "src/services/canonical_product_snapshot_service.py",
    "src/services/system_product_snapshot_service.py",
    "src/services/frontend_view_artifact_v2259_service.py",
