    "src/api/routes/frontend_views.py",
    "web_demo/core/hash-view-client-v2259.js"
  ],
  "forbiddenStalePredicates": [
    {"id":"data_version_only_head_invalidation","literal":"requested_version and row.get(\"data_version\") != requested_version"},
    {"id":"legacy_hash_view_client_version","literal":"const VERSION = \"22.5.9\";"},
    {"id":"signal_derived_products_hash_view_builder","literal":"lambda: read_product_views(data_version=data_version"}
  ],
  "rules": [
    "Scan only files present in TARGET competition runtime hash-lineage closure.",
    "Every field hit is recorded with exact runtime path and SHA-256 content hash.",
    "Head identity requires active dataVersion plus runtimeStateHash; runtimeStateHash includes canonicalProductSetSnapshotHash.",
    "Products Hash View must materialize from canonical product snapshot projection only; Signal/Agent admission is not product inventory authority.",
    "Reset/no active runtime must invalidate any previous dataVersion Head and publish an empty current view without canonical-history fallback.",
    "Canonical product-set hash changes must invalidate the current Head even when pipeline execution state is unchanged.",
    "Immutable module and manifest Artifacts remain content-addressed; only Head polling is no-store.",
    "Canonical V23 Registry root is not rotated by this repair; field/runtime projection and module contract hashes rotate under the sealed root."
  ],
