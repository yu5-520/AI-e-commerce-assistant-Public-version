# V22.5.4 server deployment contract example.
# Copy to /etc/ai-ecommerce-assistant/deployment.env on the server.
# Never commit real tokens or machine secrets.

AI_GITHUB_REPOSITORY=yu5-520/AI-e-commerce-assistant
AI_RELEASE_BRANCH=main
AI_ECOMMERCE_ROOT=/opt/ai-ecommerce-assistant
AI_RELEASE_PYTHON=/opt/ai-runtime/python/current/bin/python3.11
AI_RELEASE_KEEP_COUNT=2
AI_ECOMMERCE_BACKUP_KEEP_COUNT=1
AI_DEPLOYMENT_MIN_FREE_BYTES=536870912

# Keep the real token in either this deployment contract or the legacy protected
# file /etc/ai-ecommerce-assistant/github-artifact.env (mode 0600).
# AI_GITHUB_TOKEN=github_pat_REDACTED
