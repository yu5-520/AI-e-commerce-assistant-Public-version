{
  "schema": "competition.runtime_verification_pilot.v1",
  "version": "2026.08.10.6",
  "pilotOnly": true,
  "extractionToMotherArchitectureAllowed": false,
  "modes": ["repository", "ecs-candidate", "ecs-runtime"],
  "requiredSourceFiles": [
    "requirements.lock",
    "config/competition_runtime_scope.json",
    "config/v23_registry_runtime.json",
    "config/deployment/runtime_callable_authority_v1.json",
    "config/deployment/runtime_verification_pilot_v1.json",
    "config/deployment/competition_execution_gate.py",
    "scripts/deploy_release.sh",
    "release/release-policy.json"
  ],
  "sourceIdentityFiles": [
    "requirements.lock",
    "config/competition_runtime_scope.json",
    "config/v23_registry_runtime.json",
    "config/deployment/runtime_callable_authority_v1.json",
    "config/deployment/runtime_verification_pilot_v1.json",
    "config/deployment/competition_execution_gate.py",
    "release/release-policy.json",
    "scripts/deploy_release.sh",
    "src/services/hard_interface_bridge_v2301_service.py",
    "src/services/station_truth_contract_v225_service.py",
    "src/services/artifact_signal_admission_v225_service.py",
    "src/services/station_contract_service.py",
    "src/services/station_business_artifact_service.py"
  ],
  "runtimeConfigFiles": [
    "config/competition_runtime_scope.json",
    "config/v23_registry_runtime.json",
    "config/deployment/runtime_callable_authority_v1.json",
    "config/deployment/runtime_verification_pilot_v1.json",
    "release/release-policy.json"
  ],
  "runtimeEnvironmentKeys": [
    "AI_ECOMMERCE_ROOT",
    "AI_RELEASE_REQUIRED",
    "AI_RELEASE_PYTHON",
    "AI_BOOTSTRAP_PYTHON",
    "PYTHONPATH",
    "VIRTUAL_ENV",
    "PORT"
  ],
  "secretPresenceKeys": [
    "DASHSCOPE_API_KEY",
    "QWEN_API_KEY",
    "OPENAI_API_KEY",
    "DEEPSEEK_API_KEY"
  ],
  "database": {
    "defaultRelativePath": "shared/logs/product_workbench.sqlite3",
    "stateTables": [
      "imported_report_rows",
      "pipeline_jobs",
      "station_queue",
      "pipeline_items",
      "artifact_registry",
      "frontend_view_head_v2259"
    ],
    "activeDataVersionTable": "imported_report_rows",
    "activeDataVersionColumn": "data_version",
    "migrationTable": "alembic_version",
    "migrationColumn": "version_num",
    "sqliteUserVersionFallback": true,
    "quickCheckRequired": true,
    "hashSchemaSeparatelyFromState": true
  },
  "runtime": {
    "processNeedles": ["uvicorn", "src.api.main:app"],
    "requiredPythonMajorMinor": "3.11",
    "currentSymlinkMustMatchLiveCwd": true
  },
  "identity": {
    "source": ["sourceCommit", "releaseHash", "sourceIdentityHash", "repositoryGateHash"],
    "runtime": ["pythonIdentityHash", "dependencyHash", "runtimeEnvHash", "configHash", "runtimeCallableAuthorityHash"],
    "database": ["dataVersion", "databaseSchemaHash", "migrationHead", "databaseStateHash"],
    "execution": "sha256(ordered identity vector)",
    "order": [
      "sourceCommit",
      "releaseHash",
      "dataVersion",
      "repositoryGateHash",
      "pythonIdentityHash",
      "dependencyHash",
      "runtimeEnvHash",
      "configHash",
      "runtimeCallableAuthorityHash",
      "databaseSchemaHash",
      "migrationHead",
      "databaseStateHash"
    ]
  },
  "rules": [
    "The same verifier implementation runs in repository, ECS candidate and ECS live-runtime contexts.",
    "RepositoryGateHash must remain identical when the same sealed source candidate is revalidated on ECS.",
    "Source Identity contains only release-shipped files so repository and sealed-candidate identities are comparable.",
    "Gate controller, deployment controller and callable-authority projection are inside the sealed config/source identity boundary.",
    "Secret values are never emitted or hashed; only configured secret presence booleans are recorded.",
    "Database schema identity and mutable database state identity are separate hashes.",
    "Active dataVersion follows the same newest-rowid semantics as the current-run pipeline-live projection without importing application runtime.",
    "migrationHead prefers the configured migration table and falls back to SQLite PRAGMA user_version when no migration table exists.",
    "ECS runtime mode binds identity to the actual uvicorn process cwd, process environment and current symlink.",
    "Identity reports expose an ordered vector so the first divergent field can be treated as the execution breakpoint.",
    "This remains a competition-repository pilot until repeated real deployments demonstrate low false positives and missed-breakpoint rates."
  ]
}
