{
  "schema": "evaluation.contract.v269b.v1",
  "version": "26.9.B.1",
  "noCompositeScore": true,
  "causalAttributionForbidden": true,
  "epsilon": 1e-09,
  "metrics": {
    "agent1.judgement_accuracy": {
      "version": "1.0.0",
      "calculator": "label_ratio",
      "definition": "Share of verifiably labelled JudgementNodes whose judgement matches the later verified label.",
      "formula": "correct_labelled_judgements / labelled_judgements",
      "numerator": "correct_labelled_judgements",
      "denominator": "labelled_judgements",
      "unit": "ratio",
      "observationWindow": "label_source_defined",
      "requiredInputs": ["correctLabelledJudgements", "labelledJudgements", "labelSource"],
      "missingRules": ["NO_VERIFIABLE_LABEL", "ZERO_LABELLED_SAMPLE"],
      "supports": ["label-backed judgement comparison"],
      "doesNotSupport": ["model self-certification", "unlabelled judgement accuracy claim"]
    },
    "agent1.action_relevance": {
      "version": "1.0.0",
      "calculator": "label_ratio",
      "definition": "Share of verifiably reviewed DecisionAction candidates judged relevant to the frozen business condition.",
      "formula": "relevant_labelled_actions / labelled_actions",
      "numerator": "relevant_labelled_actions",
      "denominator": "labelled_actions",
      "unit": "ratio",
      "observationWindow": "review_defined",
      "requiredInputs": ["relevantLabelledActions", "labelledActions", "labelSource"],
      "missingRules": ["NO_VERIFIABLE_LABEL", "ZERO_LABELLED_SAMPLE"],
      "supports": ["review-backed action relevance"],
      "doesNotSupport": ["automatic truth of an action", "execution permission"]
    },
    "agent1.graph_value": {
      "version": "1.0.0",
      "calculator": "external_value_ratio",
      "definition": "Versioned external evaluation of whether graph content contributed useful, preserved decision information.",
      "formula": "validated_value_events / evaluated_value_events",
      "numerator": "validated_value_events",
      "denominator": "evaluated_value_events",
      "unit": "ratio",
      "observationWindow": "evaluation_defined",
      "requiredInputs": ["validatedValueEvents", "evaluatedValueEvents", "evaluationSource"],
      "missingRules": ["NO_EXTERNAL_EVALUATION", "ZERO_EVALUATED_SAMPLE"],
      "supports": ["externally evaluated graph usefulness"],
      "doesNotSupport": ["Agent1 self-score", "more nodes imply more value"]
    },
    "agent1.false_expansion_rate": {
      "version": "1.0.0",
      "calculator": "label_ratio",
      "definition": "Rate of reviewed graph additions labelled unnecessary for the frozen task scope.",
      "formula": "labelled_false_expansions / labelled_expansions",
      "numerator": "labelled_false_expansions",
      "denominator": "labelled_expansions",
      "unit": "ratio",
      "observationWindow": "review_defined",
      "requiredInputs": ["labelledFalseExpansions", "labelledExpansions", "labelSource"],
      "missingRules": ["NO_VERIFIABLE_LABEL", "ZERO_LABELLED_SAMPLE"],
      "supports": ["review-backed expansion control"],
      "doesNotSupport": ["penalizing graph size by itself"]
    },
    "agent2.prediction_accuracy": {
      "version": "1.0.0",
      "calculator": "relative_prediction_accuracy",
      "definition": "Relative closeness of actual observed value to the frozen expected value when expected magnitude is not near zero.",
      "formula": "max(0, 1 - abs(actual_value - expected_value) / abs(expected_value))",
      "numerator": "abs(actual_value - expected_value)",
      "denominator": "abs(expected_value)",
      "unit": "ratio",
      "observationWindow": "PlanAction.reviewWindow",
      "requiredInputs": ["expectedValue", "actualValue"],
      "missingRules": ["ACTUAL_NOT_OBSERVED", "EXPECTED_VALUE_NEAR_ZERO"],
      "supports": ["prediction closeness under frozen PlanAction window"],
      "doesNotSupport": ["causal attribution", "business success by itself"]
    },
    "agent2.expected_delta": {
      "version": "1.0.0",
      "calculator": "expected_delta",
      "definition": "System-recomputed delta between frozen expected value and frozen baseline.",
      "formula": "expected_value - baseline_value",
      "numerator": "expected_value - baseline_value",
      "denominator": null,
      "unit": "metric_native",
      "observationWindow": "PlanAction.reviewWindow",
      "requiredInputs": ["baselineValue", "expectedValue", "metricUnit"],
      "missingRules": ["BASELINE_MISSING", "EXPECTED_VALUE_MISSING"],
      "supports": ["recomputation of plan expectation"],
      "doesNotSupport": ["actual outcome claim"]
    },
    "agent2.actual_delta": {
      "version": "1.0.0",
      "calculator": "actual_delta",
      "definition": "Observed delta between later immutable observation and frozen baseline.",
      "formula": "actual_value - baseline_value",
      "numerator": "actual_value - baseline_value",
      "denominator": null,
      "unit": "metric_native",
      "observationWindow": "PlanAction.reviewWindow",
      "requiredInputs": ["baselineValue", "actualValue", "metricUnit"],
      "missingRules": ["BASELINE_MISSING", "ACTUAL_NOT_OBSERVED"],
      "supports": ["observed change from baseline"],
      "doesNotSupport": ["Agent or RAG causality"]
    },
    "agent2.delta_realization_rate": {
      "version": "1.0.0",
      "calculator": "delta_realization_rate",
      "definition": "Ratio of actual delta to frozen expected delta. Negative expected deltas remain sign-aware; zero or near-zero expected delta is not divided.",
      "formula": "actual_delta / expected_delta",
      "numerator": "actual_delta",
      "denominator": "expected_delta",
      "unit": "ratio",
      "observationWindow": "PlanAction.reviewWindow",
      "requiredInputs": ["baselineValue", "expectedValue", "actualValue", "metricUnit"],
      "missingRules": ["ACTUAL_NOT_OBSERVED", "EXPECTED_DELTA_NEAR_ZERO"],
      "supports": ["direction-aware realization comparison"],
      "doesNotSupport": ["causal attribution", "quality comparison across unrelated metrics"]
    },
    "agent3.sop_fidelity": {
      "version": "1.0.0",
      "calculator": "count_ratio",
      "definition": "Share of required authorized SOP steps executed without semantic substitution.",
      "formula": "matched_authorized_steps / required_authorized_steps",
      "numerator": "matched_authorized_steps",
      "denominator": "required_authorized_steps",
      "unit": "ratio",
      "observationWindow": "execution_window",
      "requiredInputs": ["matchedAuthorizedSteps", "requiredAuthorizedSteps"],
      "missingRules": ["ZERO_REQUIRED_STEPS", "EXECUTION_NOT_OBSERVED"],
      "supports": ["fidelity to authorized OperationGraph"],
      "doesNotSupport": ["business result quality"]
    },
    "agent3.execution_completion": {
      "version": "1.0.0",
      "calculator": "count_ratio",
      "definition": "Share of planned executable stages that reached a terminal completed state.",
      "formula": "completed_stages / planned_stages",
      "numerator": "completed_stages",
      "denominator": "planned_stages",
      "unit": "ratio",
      "observationWindow": "execution_window",
      "requiredInputs": ["completedStages", "plannedStages"],
      "missingRules": ["ZERO_PLANNED_STAGES", "EXECUTION_NOT_OBSERVED"],
      "supports": ["execution completion"],
      "doesNotSupport": ["business success"]
    },
    "agent3.deviation_rate": {
      "version": "1.0.0",
      "calculator": "count_ratio",
      "definition": "Observed unauthorized or unexpected execution deviations divided by executed steps.",
      "formula": "deviation_events / executed_steps",
      "numerator": "deviation_events",
      "denominator": "executed_steps",
      "unit": "ratio",
      "observationWindow": "execution_window",
      "requiredInputs": ["deviationEvents", "executedSteps"],
      "missingRules": ["ZERO_EXECUTED_STEPS", "EXECUTION_NOT_OBSERVED"],
      "supports": ["execution deviation frequency"],
      "doesNotSupport": ["reason for deviation without evidence"]
    },
    "agent3.rollback_rate": {
      "version": "1.0.0",
      "calculator": "count_ratio",
      "definition": "Rollback events divided by eligible executions. A correct rollback may represent successful risk control and is not automatically negative quality.",
      "formula": "rollback_events / eligible_executions",
      "numerator": "rollback_events",
      "denominator": "eligible_executions",
      "unit": "ratio",
      "observationWindow": "execution_window",
      "requiredInputs": ["rollbackEvents", "eligibleExecutions"],
      "missingRules": ["ZERO_ELIGIBLE_EXECUTIONS", "EXECUTION_NOT_OBSERVED"],
      "supports": ["rollback frequency"],
      "doesNotSupport": ["rollback quality judgement without cause review"]
    },
    "system.evidence_completeness": {
      "version": "1.0.0",
      "calculator": "count_ratio",
      "definition": "Present required evidence references divided by required evidence references.",
      "formula": "present_required_evidence / required_evidence",
      "numerator": "present_required_evidence",
      "denominator": "required_evidence",
      "unit": "ratio",
      "observationWindow": "task_lifecycle",
      "requiredInputs": ["presentRequiredEvidence", "requiredEvidence"],
      "missingRules": ["ZERO_REQUIRED_EVIDENCE"],
      "supports": ["evidence coverage"],
      "doesNotSupport": ["evidence truth by count alone"]
    },
    "system.business_outcome": {
      "version": "1.0.0",
      "calculator": "observed_outcome",
      "definition": "Observed business metric value or delta stored with its native unit and source; no causal attribution is implied.",
      "formula": "observed_value",
      "numerator": "observed_value",
      "denominator": null,
      "unit": "metric_native",
      "observationWindow": "source_defined",
      "requiredInputs": ["observedValue", "metricUnit", "observationSource"],
      "missingRules": ["OUTCOME_NOT_OBSERVED"],
      "supports": ["observed business outcome"],
      "doesNotSupport": ["attribution to Agent", "attribution to RAG", "counterfactual claim"]
    }
  }
}
