# Copy this file to /etc/ai-ecommerce-assistant/qwen37-plus.env
# Then chmod 600 and add the real DASHSCOPE_API_KEY outside GitHub.

LLM_ENABLED=true
LLM_PROVIDER=aliyun_bailian
DASHSCOPE_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen3.7-plus
BAILIAN_ENABLE_THINKING=true
LLM_ITEM_RESULT_CACHE_ENABLED=true

PRODUCT_JUDGMENT_AGENT_ENABLED=true
PRODUCT_JUDGMENT_AGENT_PROVIDER=aliyun_bailian
PRODUCT_JUDGMENT_AGENT_MODEL=qwen3.7-plus
PRODUCT_JUDGMENT_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PRODUCT_JUDGMENT_AGENT_ENABLE_THINKING=true

ACTION_PLAN_AGENT_ENABLED=true
ACTION_PLAN_AGENT_PROVIDER=aliyun_bailian
ACTION_PLAN_AGENT_MODEL=qwen3.7-plus
ACTION_PLAN_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ACTION_PLAN_AGENT_ENABLE_THINKING=true

TASK_MAPPING_AGENT_ENABLED=true
TASK_MAPPING_AGENT_PROVIDER=aliyun_bailian
TASK_MAPPING_AGENT_MODEL=qwen3.7-plus
TASK_MAPPING_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
